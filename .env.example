# ==============================================================================
# CODE CANARY — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` or `apps/api/.env.local` and add your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Reasoning & Vector Embeddings (Choose Google Gemini or OpenAI)
# ------------------------------------------------------------------------------
# Google Gemini (Recommended — free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (Alternative — key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. Modal Labs Cloud Workers (For distributed repository scanning)
# ------------------------------------------------------------------------------
# Get your token from: https://modal.com/settings/tokens
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here
MODAL_PROFILE=default
USE_PYTHON_BRIDGE=true

# ------------------------------------------------------------------------------
# 3. GitHub Token (For GitHub Advisory / GHSA API rate limits)
# ------------------------------------------------------------------------------
# Personal access token with read:packages or public repo scope: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 4. NIST NVD API Key (Optional — for higher National Vulnerability DB rate limits)
# ------------------------------------------------------------------------------
# Request a key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ------------------------------------------------------------------------------
# 5. Vector Store Configuration (RAG Knowledge Base)
# ------------------------------------------------------------------------------
# Options: memory, sqlite, pinecone
VECTOR_STORE_TYPE=memory

# If using VECTOR_STORE_TYPE=sqlite:
SQLITE_DB_PATH=./vector-store.db

# If using VECTOR_STORE_TYPE=pinecone (Optional):
PINECONE_API_KEY=
PINECONE_INDEX=
